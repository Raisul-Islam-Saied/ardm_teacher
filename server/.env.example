PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Dhaka
MONGO_URI=mongodb://127.0.0.1:27017/ardm_enterprise_db
# First origin is also used to build password-reset links.
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=90d
# Set the same newly generated key in the Apps Script property of the same name.
RESULTS_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxoQM0Xf5SrusbRuCwe4b3s92rK7e014DYkgiuM3yOLs9KKZ773MUkmysrM3PcxyCbpbw/exec
RESULTS_APPS_SCRIPT_ADMIN_KEY=
# Server-only SMS gateway credentials and provider endpoints
SMS_API_URL=
SMS_BULK_API_URL=
SMS_BALANCE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Server-only SMTP settings for individual payroll emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=আবদুর রাজ্জাক দাখিল মাদ্রাসা
# GET /api/v1/integrations/teachers|students?page=1&limit=100 and /:id-or-code
# Generate separate server-to-server keys with crypto.randomBytes(32); keep them out of frontend code.
RESULTS_APP_API_KEY=
ADMIT_CARD_APP_API_KEY=
